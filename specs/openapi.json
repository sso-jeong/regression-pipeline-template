  "components": {
    "schemas": {
      "Chat": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "member_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Member Ids"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "member_ids",
          "created_at"
        ],
        "title": "Chat"
      },
      "ChatCreate": {
        "properties": {
          "member_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 2,
            "title": "Member Ids"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "member_ids"
        ],
        "title": "ChatCreate"
      },
      "Error": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Error"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "injected_bugs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Injected Bugs"
          }
        },
        "type": "object",
        "required": [
          "status",
          "injected_bugs"
        ],
        "title": "Health"
      },
      "Message": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "chat_id": {
            "type": "string",
            "title": "Chat Id"
          },
          "sender_id": {
            "type": "string",
            "title": "Sender Id"
          },
          "seq": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Seq",
            "description": "채팅방 안에서 1부터 1씩 증가하는 순번"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "chat_id",
          "sender_id",
          "seq",
          "text",
          "created_at"
        ],
        "title": "Message"
      },
      "MessageCreate": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "MessageCreate"
      },
      "MessagePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "Items"
          },
          "next_after_seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next After Seq",
            "description": "다음 페이지 커서. 마지막 페이지면 null"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_after_seq"
        ],
        "title": "MessagePage"
      },
      "ReadRequest": {
        "properties": {
          "up_to_seq": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Up To Seq"
          }
        },
        "type": "object",
        "required": [
          "up_to_seq"
        ],
        "title": "ReadRequest"
      },
      "ReadState": {
        "properties": {
          "chat_id": {
            "type": "string",
            "title": "Chat Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "last_read_seq": {
            "type": "integer",
            "title": "Last Read Seq"
          }
        },
        "type": "object",
        "required": [
          "chat_id",
          "user_id",
          "last_read_seq"
        ],
        "title": "ReadState"
      },
      "Unread": {
        "properties": {
          "chat_id": {
            "type": "string",
            "title": "Chat Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "unread_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Unread Count"
          }
        },
        "type": "object",
        "required": [
          "chat_id",
          "user_id",
          "unread_count"
        ],
        "title": "Unread"
      },
      "User": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "User"
      },
      "UserCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "UserCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
