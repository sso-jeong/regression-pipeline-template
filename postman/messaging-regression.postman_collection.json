{
  "info": {
    "name": "Messaging API Regression (v1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman 컬렉션 → Newman → Jenkins 회귀 파이프라인 (v1)"
  },
  "item": [
    {
      "name": "01 준비",
      "item": [
        {
          "name": "사용자 생성 - alice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"alice\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"alice\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "사용자 생성 - bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"bob\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"bob\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "사용자 생성 - mallory",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"mallory\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"mallory\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "채팅방 생성",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"멤버 2명\", () => pm.expect(pm.response.json().member_ids).to.have.lengthOf(2));",
                  "pm.collectionVariables.set(\"chat\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chats"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"member_ids\": [\"{{alice}}\", \"{{bob}}\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "02 메시지",
      "item": [
        {
          "name": "메시지 전송 (Idempotency-Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"첫 메시지 순번은 1\", () => pm.expect(pm.response.json().seq).to.eql(1));",
                  "pm.collectionVariables.set(\"firstMessageId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{alice}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-{{chat}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chats/{{chat}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chats",
                "{{chat}}",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"text\": \"안녕\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "같은 키로 재전송",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"같은 메시지를 돌려준다\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"firstMessageId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{alice}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-{{chat}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chats/{{chat}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chats",
                "{{chat}}",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"text\": \"안녕\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "목록 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"재전송이 중복 저장되지 않았다\", () => pm.expect(pm.response.json().items).to.have.lengthOf(1));",
                  "pm.test(\"마지막 페이지 커서는 null\", () => pm.expect(pm.response.json().next_after_seq).to.be.null);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chats/{{chat}}/messages?after_seq=0&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chats",
                "{{chat}}",
                "messages"
              ],
              "query": [
                {
                  "key": "after_seq",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "멤버 아닌 사용자 전송",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 Forbidden\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{mallory}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chats/{{chat}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chats",
                "{{chat}}",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"text\": \"침입\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "03 읽음",
      "item": [
        {
          "name": "bob 안 읽음",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"안 읽음 1\", () => pm.expect(pm.response.json().unread_count).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chats/{{chat}}/unread",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chats",
                "{{chat}}",
                "unread"
              ]
            }
          }
        },
        {
          "name": "bob 읽음 처리",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"읽음 위치 1\", () => pm.expect(pm.response.json().last_read_seq).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chats/{{chat}}/read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chats",
                "{{chat}}",
                "read"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"up_to_seq\": 1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "bob 안 읽음 다시",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"안 읽음 0\", () => pm.expect(pm.response.json().unread_count).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chats/{{chat}}/unread",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chats",
                "{{chat}}",
                "unread"
              ]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"응답 시간 500ms 이내\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ]
}
